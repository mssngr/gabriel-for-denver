<section data-step="2" class="hidden flex-col gap-4">
  <h2 class="card-title">Payment</h2>
  <div class="rounded-box bg-secondary/10 p-4 text-sm">
    <p class="font-semibold text-lg" id="donation-summary-amount"></p>
  </div>
  <div id="payment-element"></div>
  <p class="text-xs opacity-70">
    Your card is processed securely with Stripe.
  </p>
  <div class="flex gap-2">
    <button type="button" class="btn btn-ghost" data-back>Back</button>
    <button id="donation-submit" type="submit" class="btn btn-accent flex-1"
      >Contribute</button
    >
  </div>
</section>
