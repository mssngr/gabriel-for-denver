---
import { marked } from 'marked'
import type { Lang } from '../../lib/platform'
import { localized } from '../../lib/platform'
import type { GuideEntry, PlankEntry } from '../../lib/platform-content'
import Icon from '../icon.astro'

interface Props {
  guide: GuideEntry
  planks: PlankEntry[]
  lang: Lang
}

const { guide, planks, lang } = Astro.props

const title = localized(guide.data, 'title', lang) ?? guide.data.title
const stance = localized(guide.data, 'stance', lang) ?? guide.data.stance
const href =
  lang === 'es'
    ? `/es/platform/${guide.data.slug}`
    : `/platform/${guide.data.slug}`
---

<article class="border border-black/15 rounded-2xl p-6 text-black bg-base">
  <a href={href} class="no-underline">
    <h2 class="inline-flex items-center gap-2 text-2xl">
      <Icon name={guide.data.lucideIcon} class="size-7" />
      {title}
    </h2>
  </a>
  <div
    class="mt-1 font-light text-black/70 [&_p]:text-base"
    set:html={marked.parse(stance)}
  />
  {
    planks.length > 0 && (
      <ul class="list-none pl-0 mt-4 border-t border-black/10">
        {planks.map((plank, index) => (
          <li class="flex gap-3 items-baseline py-2.5 border-b border-black/5 last:border-b-0">
            <b class="text-primary text-xs tracking-wider shrink-0">
              {String(index + 1).padStart(2, '0')}
            </b>
            <span class="text-base leading-snug">
              {localized(plank.data, 'commitment', lang) ??
                plank.data.commitment}
            </span>
          </li>
        ))}
      </ul>
    )
  }
</article>
