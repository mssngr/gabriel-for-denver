---
import { ArrowRight, ChevronRight } from '@lucide/astro'
import { Image } from 'astro:assets'
import { Marked } from 'marked'
import type { Lang } from '../../lib/platform'
import {
  actionCount,
  guideCardCta,
  guideCardLabel,
  localized,
  plankUrl,
} from '../../lib/platform'
import type { GuideEntry, PlankEntry } from '../../lib/platform-content'
import Icon from '../icon.astro'
import CardTracking from './card-tracking.astro'

interface Props {
  guide: GuideEntry
  planks: PlankEntry[]
  lang: Lang
}

const { guide, planks, lang } = Astro.props

const title = localized(guide.data, 'title', lang) ?? guide.data.title
const stance = localized(guide.data, 'stance', lang) ?? guide.data.stance
// The card's whole content used to sit inside one link, which is why a
// markdown link in `stance` renders as plain text rather than a nested <a>
// — now that the title and each action are their own links (see the
// stretched-link markup below), a stance link would just be a third,
// smaller target squeezed between them, no easier to read or to hit.
const stanceHtml = new Marked({
  renderer: { link: ({ text }) => text },
}).parse(stance)
const artwork = guide.data.artwork
// Blank means decorative, as in guide-hero.astro, which explains why.
const artworkAlt = localized(guide.data, 'artworkAlt', lang) ?? ''
const href =
  lang === 'es'
    ? `/es/platform/${guide.data.slug}`
    : `/platform/${guide.data.slug}`
const cta = guideCardCta(lang)
---

<article
  class="card-link relative flex h-full flex-col overflow-hidden rounded-2xl bg-white text-black"
  data-card-tracking
  data-guide-slug={guide.data.slug}
>
  <div class="flex-1 p-6">
    {
      /* Words first, illustration second. Leading with the art made the index
         read as a gallery: on a phone the first card filled the screen with a
         drawing, and on a laptop every card's title sat below the fold. */
    }
    <div class="flex items-start justify-between gap-3">
      <h2 class="inline-flex items-center gap-2 text-2xl">
        {!artwork && <Icon name={guide.data.lucideIcon} class="size-7" />}
        <a
          href={href}
          aria-label={guideCardLabel(title, lang)}
          class="card-link__title"
          data-card-target="card"
        >
          {title}
        </a>
      </h2>
      {
        /* The card's one on-screen cue that doesn't need a pointer to
           reveal it — the footer below says the same thing in words, but
           it can be a whole screen away on a phone (see design.html). */
      }
      <span class="card-link__chip text-white" aria-hidden="true">
        <ArrowRight class="size-5" />
      </span>
    </div>
    <div
      class="mt-1 font-light text-black/70 [&_strong]:font-bold [&_p]:text-base"
      set:html={stanceHtml}
    />
    {
      /* Cropped to a square so a tall/portrait piece of art doesn't blow out
         the card's height (Q6). The small icon above only stands in for a
         guide that has no artwork yet. */
      artwork && (
        <Image
          src={artwork}
          alt={artworkAlt}
          class="w-full aspect-square object-cover rounded-xl mt-5"
        />
      )
    }
    {
      planks.length > 0 && (
        <div class="mt-5 border-t border-black/10 pt-3">
          {/* The count says there is something under the artwork, which the
              list alone can't do until the reader has scrolled to it. */}
          <p class="text-xs tracking-[0.18em] uppercase font-semibold text-primary mb-1">
            {actionCount(planks.length, lang)}
          </p>
          <ul class="list-none pl-0 m-0">
            {planks.map((plank, index) => (
              <li class="card-link__row flex gap-3 items-baseline py-2.5 border-b border-black/5 last:border-b-0">
                <b class="text-primary text-xs tracking-wider shrink-0">
                  {String(index + 1).padStart(2, '0')}
                </b>
                <a
                  href={plankUrl(href, plank.data.slug)}
                  class="card-link__row-link text-base leading-snug"
                  data-card-target="action"
                  data-plank-slug={plank.data.slug}
                >
                  {localized(plank.data, 'commitment', lang) ??
                    plank.data.commitment}
                </a>
                <ChevronRight
                  class="card-link__chevron ml-auto size-4 shrink-0 self-center text-primary"
                  aria-hidden="true"
                />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
  {
    /* Decorative: the link it sits on top of already carries this same
       text in its aria-label (guideCardLabel), so a screen reader would
       otherwise announce it twice. */
  }
  <p
    class="card-link__footer text-white text-lg font-semibold"
    aria-hidden="true"
  >
    <span>{cta}</span>
    <ArrowRight class="size-4" />
  </p>
</article>
<CardTracking />
