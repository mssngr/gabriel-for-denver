---
import { marked } from 'marked'
import type { Lang } from '../../lib/platform'
import { localized, plankAnchor } from '../../lib/platform'
import type { PlankEntry } from '../../lib/platform-content'

interface Props {
  plank: PlankEntry
  lang: Lang
  index: number
}

const { plank, lang, index } = Astro.props
const anchor = plankAnchor(plank.data.slug)

// Ships as a <details>, not an overlay. With JS off this is an ordinary inline
// disclosure: it prints, crawlers read it, and linking to #plank-<slug> opens
// it natively. The script on the page only promotes it into a fixed panel.
const t =
  lang === 'es'
    ? {
        open: 'Leer la política',
        close: 'Cerrar',
        problem: 'El problema',
        authority: 'Lo que puede hacer el Concejo',
        sources: 'Fuentes',
        plank: 'Punto',
      }
    : {
        open: 'Read the policy',
        close: 'Close',
        problem: 'The problem',
        authority: 'What Council can do',
        sources: 'Sources',
        plank: 'Plank',
      }

const detail = localized(plank.data, 'detail', lang)
const authority = localized(plank.data, 'authority', lang)
const commitment =
  localized(plank.data, 'commitment', lang) ?? plank.data.commitment
const sources = plank.data.sources ?? []
const number = String(index + 1).padStart(2, '0')
---

<details
  class="plank-detail"
  id={anchor}
  data-plank-slug={plank.data.slug}
  data-guide-slug={plank.data.guide}
>
  <summary
    class="plank-detail__toggle inline-flex items-center gap-2 rounded-2xl border-[1.5px] border-current px-4 pt-3 pb-2 text-lg font-semibold cursor-pointer list-none [&::-webkit-details-marker]:hidden"
    data-plank-slug={plank.data.slug}
  >
    {t.open} &rarr;
  </summary>
  <div class="plank-detail__scrim hidden" data-plank-close></div>
  <div
    class="plank-detail__panel mt-6 max-w-2xl bg-base text-black rounded-2xl p-6"
  >
    <div
      class="flex items-start justify-between gap-4 border-b border-black/10 pb-4"
    >
      <div>
        <p class="text-xs tracking-[0.2em] uppercase font-bold text-primary">
          {t.plank}
          {number}
        </p>
        <h3 class="mt-2 text-2xl leading-tight">{commitment}</h3>
      </div>
      <button
        type="button"
        class="shrink-0 size-9 rounded-full border-[1.5px] border-black/25 grid place-items-center text-lg leading-none"
        aria-label={t.close}
        data-plank-close>&times;</button
      >
    </div>

    <div class="flex flex-col gap-7 pt-6">
      {
        detail && (
          <div>
            <p class="text-xs tracking-[0.2em] uppercase font-bold text-primary mb-2">
              {t.problem}
            </p>
            <div
              class="font-light [&_p]:text-base [&_p:not(:first-child)]:mt-3"
              set:html={marked.parse(detail)}
            />
          </div>
        )
      }
      {
        authority && (
          <div>
            <p class="text-xs tracking-[0.2em] uppercase font-bold text-primary mb-2">
              {t.authority}
            </p>
            <p class="font-light text-base">{authority}</p>
            {plank.data.timeline && (
              <span class="inline-block mt-3 rounded-full bg-neutral text-tertiary text-xs tracking-widest uppercase font-bold px-3 pt-1.5 pb-1">
                {plank.data.timeline}
              </span>
            )}
          </div>
        )
      }
      {
        sources.length > 0 && (
          <div>
            <p class="text-xs tracking-[0.2em] uppercase font-bold text-primary mb-2">
              {t.sources}
            </p>
            <ul class="list-none pl-0 font-light text-sm flex flex-col gap-2">
              {sources.map((source, sourceIndex) => (
                <li class="flex gap-2 text-sm">
                  <b class="text-primary">{sourceIndex + 1}</b>
                  <a class="link" href={source.url}>
                    {(lang === 'es' && source.label_es) || source.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</details>
