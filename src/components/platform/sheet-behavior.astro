---
// Behaviour that promotes an open plank <details> into a fixed sheet.
//
// One component so both language pages share an implementation: duplicating
// this across two near-identical page files is the shape that produced the
// analytics and anchor drift PR #8 had to go back and repair.
//
// Deliberately a bundled <script> rather than the `is:inline` the rest of the
// repo uses. Inline scripts can't import, and the inert bookkeeping below is
// the most error-prone logic on the page — it has already shipped wrong once.
// Keeping it in src/lib/sheet.ts means it is covered by jsdom unit tests in CI
// instead of only by someone opening two panels in the right order.
---

<script>
  import { applySheetInert } from '../../lib/sheet'

  // The panels are <details> elements and work on their own: with JS off they
  // are ordinary inline disclosures that print and are read by crawlers. This
  // only promotes an open one into a fixed sheet, keeps the URL in step so the
  // state is shareable, and closes it the ways a sheet is expected to close.
  const root = document.documentElement
  // Tells global.css that this script is handling the panels, so an open one
  // is styled as a sheet from its very first frame. See the comment on the
  // sheet rules there for why this can't wait for the `toggle` event.
  root.classList.add('js-sheet')

  const openSheet = () =>
    document.querySelector<HTMLDetailsElement>('details.plank-detail[open]')

  function syncHash(details: Element | null) {
    const url = details ? `#${details.id}` : location.pathname + location.search
    history.replaceState(null, '', url)
  }

  function closeAll() {
    for (const details of document.querySelectorAll<HTMLDetailsElement>(
      'details.plank-detail[open]',
    )) {
      details.open = false
    }
  }

  function setDialogRole(details: Element, on: boolean) {
    const panel = details.querySelector('.plank-detail__panel')
    if (!panel) return
    if (!on) {
      panel.removeAttribute('role')
      panel.removeAttribute('aria-modal')
      panel.removeAttribute('aria-labelledby')
      return
    }
    panel.setAttribute('role', 'dialog')
    panel.setAttribute('aria-modal', 'true')
    panel.setAttribute('aria-labelledby', `${details.id}-title`)
  }

  function onToggle(details: HTMLDetailsElement) {
    if (details.open) {
      for (const other of document.querySelectorAll<HTMLDetailsElement>(
        'details.plank-detail[open]',
      )) {
        if (other !== details) other.open = false
      }
      root.classList.add('sheet-open')
      setDialogRole(details, true)
      syncHash(details)
      window.posthog?.capture('plank_detail_opened', {
        guide_slug: details.dataset.guideSlug,
        plank_slug: details.dataset.plankSlug,
        lang: root.lang,
      })
      const heading = details.querySelector<HTMLElement>('h3')
      if (heading) {
        heading.setAttribute('tabindex', '-1')
        heading.focus({ preventScroll: true })
      }
    } else {
      setDialogRole(details, false)
      // Only wind the page back up once nothing is open. Closing because
      // another panel opened must not steal focus back out of the new one.
      if (!openSheet()) {
        root.classList.remove('sheet-open')
        syncHash(null)
        details
          .querySelector<HTMLElement>('summary')
          ?.focus({ preventScroll: true })
      }
    }

    // Always recomputed from what is open now, never applied as a delta —
    // see src/lib/sheet.ts for why that distinction matters.
    applySheetInert(openSheet())
  }

  // `toggle` does not bubble, so this listens in the capture phase.
  document.addEventListener(
    'toggle',
    (event) => {
      const details = event.target
      if (
        details instanceof HTMLDetailsElement &&
        details.classList.contains('plank-detail')
      )
        onToggle(details)
    },
    true,
  )

  // A panel opened before this script ran has already fired its `toggle`, so
  // nothing heard it. `.js-sheet` now styles it as a sheet, so give it the rest
  // of a sheet's setup too: dialog role, focus, inert background, the hash.
  const openedEarly = openSheet()
  if (openedEarly) onToggle(openedEarly)

  document.addEventListener('click', (event) => {
    if ((event.target as Element | null)?.closest('[data-plank-close]'))
      closeAll()
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && openSheet()) closeAll()
  })

  // Arriving on a permalink opens that plank rather than leaving the reader
  // scrolled to a closed disclosure. CSS.escape must not see the leading '#'
  // — it would escape it and produce a selector that matches nothing.
  if (location.hash) {
    const target = document.querySelector<HTMLDetailsElement>(
      `details.plank-detail#${CSS.escape(location.hash.slice(1))}`,
    )
    if (target) target.open = true
  }
</script>
