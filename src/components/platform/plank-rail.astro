---
import type { Lang } from '../../lib/platform'
import { localized, plankAnchor, showsPlankRail } from '../../lib/platform'
import type { PlankEntry } from '../../lib/platform-content'

interface Props {
  planks: PlankEntry[]
  lang: Lang
}

const { planks, lang } = Astro.props
const label = lang === 'es' ? 'Acciones de esta guía' : 'Actions in this guide'

// A field guide's index tabs: one tick per plank, sticky beside the bands so
// the reader always knows how many are left.
//
// The bands are passed in as the slot so the rail owns its own positioning
// context. It sits in a full-height overlay over exactly those bands and
// sticks within it, so it can only ever appear beside a band. It used to be
// fixed to the window, which floated it over the hero and the call to action
// too, covering the start of their text. Confining it to the bands is also
// what lets only the bands carry the wider left gutter that clears it.
//
// Sticky at 40vh with no transform, so the rail's box stays inside the
// overlay at both ends of the scroll; centring it with a translate would let
// half of it hang off the top of the first band and the bottom of the last.
//
// Hidden below md, where the bands are a single thumb-scroll and a rail would
// just cover content.
const showRail = showsPlankRail(planks.length)
---

<div class="relative">
  {
    showRail && (
      <div class="pointer-events-none absolute inset-0 z-30 hidden md:block">
        <nav
          aria-label={label}
          class="pointer-events-auto sticky top-[40vh] ml-5 flex w-fit flex-col gap-1 rounded-full bg-[rgb(9_11_20/0.7)] p-2 text-white"
        >
          {planks.map((plank, index) => (
            <a
              href={`#${plankAnchor(plank.data.slug)}`}
              class="size-8 rounded-full grid place-items-center text-xs font-bold opacity-60 hover:opacity-100 focus-visible:opacity-100"
              title={
                localized(plank.data, 'commitment', lang) ??
                plank.data.commitment
              }
            >
              {String(index + 1).padStart(2, '0')}
            </a>
          ))}
        </nav>
      </div>
    )
  }
  <slot />
</div>
