---
import { ArrowRight, ChevronRight, CircleCheck } from '@lucide/astro'
import type { Lang } from '../../lib/platform'
import {
  actionCount,
  localized,
  plankUrl,
  platformSummary,
  topicsWithActions,
} from '../../lib/platform'
import { getPublishedPlatform } from '../../lib/platform-content'
import Icon from '../icon.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

// The same guides and planks that back /platform, condensed instead of
// repeated: a quick-scan summary rather than a second copy of that page's
// stance paragraphs and artwork.
const { guides, planks } = await getPublishedPlatform()
const topics = topicsWithActions(guides, planks)
// topics.length, not guides.length: a guide published with no planks yet
// drops out of the grid below, so the eyebrow should count only the topics
// actually shown under it.
const summary = platformSummary(planks.length, topics.length, lang)
---

{
  summary && (
    <p class="text-center text-xs tracking-[0.2em] uppercase font-semibold text-primary mb-10">
      {summary}
    </p>
  )
}
<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    topics.map(({ guide, planks: guidePlanks }) => {
      const title = localized(guide.data, 'title', lang) ?? guide.data.title
      const href =
        lang === 'es'
          ? `/es/platform/${guide.data.slug}`
          : `/platform/${guide.data.slug}`
      // The card's accessible name names the action count too, not just the
      // topic — unlike guide-card.astro's full card, this one's main content
      // *is* the action list, which a bare topic name wouldn't hint at, and
      // it carries no footer of its own to draw that link from (Q4).
      const cardLabel = `${title}, ${actionCount(guidePlanks.length, lang)}`
      return (
        <article class="card-link relative flex h-full flex-col rounded-2xl p-6 text-black bg-white">
          <div class="flex items-center justify-between gap-3">
            <h2 class="inline-flex items-center gap-2 text-lg leading-tight">
              <Icon
                name={guide.data.lucideIcon}
                class="size-5 shrink-0 text-primary"
              />
              <a href={href} aria-label={cardLabel} class="card-link__title">
                {title}
              </a>
            </h2>
            <span
              class="card-link__chip card-link__chip--sm text-white"
              aria-hidden="true"
            >
              <ArrowRight class="size-3.5" />
            </span>
          </div>
          <p class="text-xs tracking-[0.16em] uppercase font-semibold text-primary/70 mt-1 mb-3">
            {actionCount(guidePlanks.length, lang)}
          </p>
          <ul class="list-none pl-0 m-0 space-y-2.5">
            {guidePlanks.map((plank) => (
              <li class="card-link__row flex gap-2.5 items-start text-sm leading-snug py-1.5">
                <CircleCheck
                  class="size-4 shrink-0 mt-0.5 text-primary"
                  aria-hidden="true"
                />
                <a
                  href={plankUrl(href, plank.data.slug)}
                  class="card-link__row-link"
                >
                  {localized(plank.data, 'commitment', lang) ??
                    plank.data.commitment}
                </a>
                <ChevronRight
                  class="card-link__chevron ml-auto size-3.5 shrink-0 self-center text-primary"
                  aria-hidden="true"
                />
              </li>
            ))}
          </ul>
        </article>
      )
    })
  }
</div>
