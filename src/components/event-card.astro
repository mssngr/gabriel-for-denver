---
import { Image } from 'astro:assets'
import { CalendarDays, CalendarPlus, MapPin } from '@lucide/astro'
import { marked } from 'marked'
import { googleCalendarUrl } from '../lib/calendar'
import { formatEventTimeRange, listedUntil, mapsUrl } from '../lib/events'

interface Props {
  title: string
  location: string
  address?: string
  startTime: Date
  endTime?: Date
  description: string
  image: ImageMetadata
  imageAlt: string
  icsUrl: string
  labels: {
    addToCalendar: string
    googleCalendar: string
    appleOutlook: string
  }
}

const {
  title,
  location,
  address,
  startTime,
  endTime,
  description,
  image,
  imageAlt,
  icsUrl,
  labels,
} = Astro.props

const calendarEvent = {
  title,
  description,
  location,
  address,
  startTime,
  endTime,
}
---

<article
  class="w-full max-w-sm md:max-w-4xl flex flex-col md:flex-row rounded-3xl bg-base-100 text-base-content shadow-xl"
  data-event-until={listedUntil(startTime).toISOString()}
>
  <div
    class="flex items-center justify-center bg-base-200 p-8 rounded-t-3xl md:rounded-tr-none md:rounded-bl-3xl md:w-56 md:shrink-0 lg:w-72"
  >
    <Image
      src={image}
      alt={imageAlt}
      class="h-32 md:h-40 lg:h-48 w-auto max-w-full object-contain"
    />
  </div>
  <div class="flex flex-1 flex-col justify-center gap-4 p-8">
    <p
      class="self-start inline-flex items-center gap-2 rounded-full bg-accent text-accent-content px-4 py-1 text-lg! font-semibold"
    >
      <CalendarDays class="size-5" />
      {formatEventTimeRange(startTime, endTime)}
    </p>
    <div>
      <h2 class="mb-2!">{title}</h2>
      <p class="text-xl! font-medium">{location}</p>
      {
        address && (
          <a
            class="link inline-flex items-start gap-2 text-lg font-light text-primary"
            href={mapsUrl(location, address)}
            target="_blank"
            rel="noopener noreferrer"
          >
            <MapPin class="size-5 shrink-0 mt-1" />
            {address}
          </a>
        )
      }
    </div>
    <div
      class="font-light [&_p]:text-lg!"
      set:html={marked.parse(description)}
    />
    <details class="dropdown self-start">
      <summary
        class="inline-flex cursor-pointer list-none items-center gap-2 rounded-full bg-primary px-5 py-2 text-lg font-semibold text-primary-content [&::-webkit-details-marker]:hidden"
      >
        <CalendarPlus class="size-5" />
        {labels.addToCalendar}
      </summary>
      <ul
        class="dropdown-content menu z-10 mt-2 w-64 rounded-2xl bg-base-100 p-2 text-base shadow-xl"
      >
        <li>
          <a
            href={googleCalendarUrl(calendarEvent)}
            target="_blank"
            rel="noopener noreferrer"
          >
            {labels.googleCalendar}
          </a>
        </li>
        <li><a href={icsUrl} download>{labels.appleOutlook}</a></li>
      </ul>
    </details>
  </div>
</article>
