---
import { Image } from 'astro:assets'
import {
  Apple,
  ArrowRight,
  CalendarDays,
  Coins,
  DatabaseZap,
  Globe,
  HouseHeart,
  MapPinHouse,
  Menu,
  MessageCircle,
  Siren,
  Users,
  X,
} from '@lucide/astro'
import logoDesktop from '../../assets/gfd-banner.svg'

const currentPath = Astro.url.pathname
---

<div
  class="relative z-40 w-full h-40 lg:h-56 p-8 lg:px-16 lg:py-8 grid grid-cols-[auto_1fr_auto] items-center lg:flex lg:justify-between transition-colors duration-300 has-[#mobile-menu-toggle:checked]:bg-base-100 lg:bg-transparent"
>
  <input
    type="checkbox"
    id="mobile-menu-toggle"
    class="peer sr-only"
    aria-label="Menu"
  />
  <a class="relative z-50 h-28 lg:h-36 shrink-0 lg:order-1" href="/"
    ><Image
      class="h-full w-auto"
      src={logoDesktop}
      alt="Logo that reads 'Gabriel for Denver'"
    /></a
  >
  <label
    for="mobile-menu-toggle"
    class="relative z-50 lg:hidden justify-self-end inline-flex items-center cursor-pointer peer-checked:[&>.icon-menu]:hidden peer-checked:[&>.icon-x]:block"
  >
    <Menu class="icon-menu size-7" aria-hidden="true" />
    <X class="icon-x size-7 hidden" aria-hidden="true" />
  </label>
  <nav
    class="fixed inset-x-0 top-0 bottom-0 z-30 flex flex-col items-center justify-center gap-8 overflow-y-auto py-12 bg-base-100 text-4xl font-semibold opacity-0 scale-95 pointer-events-none transition-all duration-300 ease-out peer-checked:opacity-100 peer-checked:scale-100 peer-checked:pointer-events-auto lg:static lg:inset-auto lg:z-auto lg:order-2 lg:flex-row lg:gap-1 lg:overflow-visible lg:py-0 lg:bg-transparent lg:text-lg lg:opacity-100 lg:scale-100 lg:pointer-events-auto lg:transition-none"
  >
    <ul
      class="menu px-1 font-semibold flex flex-col items-center gap-4 lg:flex-row lg:menu-horizontal"
    >
      <li>
        <details>
          <summary
            class={`text-3xl lg:text-2xl ${currentPath.includes('/issues') ? 'text-primary font-black' : ''}`}
            >Issues</summary
          >
          <ul class="bg-base-100 rounded-t-none p-2 z-10">
            <li>
              <a
                href="/issues/affordability"
                class={`${currentPath.includes('/issues/affordability') ? 'text-primary font-black' : ''}`}
                ><Coins />Affordability</a
              >
            </li>
            <li>
              <a
                href="/issues/housing-crisis"
                class={`${currentPath.includes('/issues/housing-crisis') ? 'text-primary font-black' : ''}`}
                ><MapPinHouse />Housing Crisis</a
              >
            </li>
            <li>
              <a
                href="/issues/criminal-injustice"
                class={`${currentPath.includes('/issues/criminal-injustice') ? 'text-primary font-black' : ''}`}
                ><Siren />Criminal Injustice</a
              >
            </li>
            <li>
              <a
                href="/issues/food-security"
                class={`${currentPath.includes('/issues/food-security') ? 'text-primary font-black' : ''}`}
                ><Apple />Food Security</a
              >
            </li>
            <li>
              <a
                href="/issues/homelessness"
                class={`${currentPath.includes('/issues/homelessness') ? 'text-primary font-black' : ''}`}
                ><HouseHeart />Homelessness</a
              >
            </li>
            <li>
              <a
                href="/issues/big-tech"
                class={`${currentPath.includes('/issues/big-tech') ? 'text-primary font-black' : ''}`}
                ><DatabaseZap />Big Tech</a
              >
            </li>
            <li>
              <a href="/issues" class="inline-flex items-center"
                >See All <ArrowRight class="size-4" /></a
              >
            </li>
          </ul>
        </details>
      </li>
      <li>
        <a
          class={`text-3xl lg:text-2xl ${currentPath.includes('/why-me') ? 'text-primary font-black' : ''}`}
          href="/why-me">Why me?</a
        >
      </li>
      <li>
        <details>
          <summary
            class={`text-3xl lg:text-2xl ${currentPath.includes('/get-involved') ? 'text-primary font-black' : ''}`}
            >Get involved</summary
          >
          <ul class="bg-base-100 rounded-t-none p-2 z-10">
            <li>
              <a
                href="/get-involved/events"
                class={`${currentPath.includes('/get-involved/events') ? 'text-primary font-black' : ''}`}
                ><CalendarDays />Events</a
              >
            </li>
            <li>
              <a
                href="/get-involved/volunteer"
                class={`${currentPath.includes('/get-involved/volunteer') ? 'text-primary font-black' : ''}`}
                ><Users />Volunteer</a
              >
            </li>
            <li>
              <a
                href="/get-involved/contact-me"
                class={`${currentPath.includes('/get-involved/contact-me') ? 'text-primary font-black' : ''}`}
                ><MessageCircle />Contact Me</a
              >
            </li>
          </ul>
        </details>
      </li>
      <li>
        <a class="btn btn-primary" href="/donate">Donate</a>
      </li>
      <li>
        <a
          href={`/es${currentPath}`}
          class="btn btn-outline btn-primary relative z-50 justify-self-center lg:order-3"
          id="lang-switch-es"
          ><Globe class="size-5" aria-hidden="true" /><span>es</span></a
        >
      </li>
    </ul>
  </nav>
</div>

<script is:inline>
  document
    .getElementById('lang-switch-es')
    ?.addEventListener('click', function () {
      window.posthog?.capture('language_switched', { to: 'es' })
    })
</script>
