---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import {
  Apple,
  ArrowRight,
  CalendarDays,
  Coins,
  DatabaseZap,
  HandCoins,
  HouseHeart,
  MapPinHouse,
  Menu,
  MessageCircle,
  Siren,
  Users,
  X,
} from '@lucide/astro'
import logoDesktop from '../../assets/gfd-banner.svg'
import logoMobile from '../../assets/gfd-mobile-banner.svg'

const currentPath = Astro.url.pathname
const recentPosts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
---

<div
  class="relative z-40 w-full h-40 lg:h-56 p-4 lg:px-16 lg:py-8 grid grid-cols-[auto_1fr_auto] items-center lg:flex lg:justify-between transition-colors duration-300 has-[#mobile-menu-toggle:checked]:bg-base-100 lg:bg-transparent"
>
  <input
    type="checkbox"
    id="mobile-menu-toggle"
    class="peer sr-only"
    aria-label="Menú"
  />
  <a
    class="relative z-50 w-32 h-32 lg:w-fit lg:h-44 shrink-0 lg:order-1"
    href="/es"
    ><Image
      class="lg:hidden"
      src={logoMobile}
      alt="Logo that reads 'Gabriel for Denver'"
    /><Image
      class="max-lg:hidden w-fit h-full"
      src={logoDesktop}
      alt="Logo that reads 'Gabriel for Denver'"
    /></a
  >
  <a
    href={currentPath.replace('/es', '') || '/'}
    class="relative z-50 link justify-self-center lg:order-3 lg:ml-4"
    id="lang-switch-en">English</a
  >
  <label
    for="mobile-menu-toggle"
    class="relative z-50 lg:hidden justify-self-end inline-flex items-center cursor-pointer peer-checked:[&>.icon-menu]:hidden peer-checked:[&>.icon-x]:block"
  >
    <Menu class="icon-menu size-7" aria-hidden="true" />
    <X class="icon-x size-7 hidden" aria-hidden="true" />
  </label>
  <nav
    class="fixed inset-x-0 top-40 bottom-0 z-30 flex flex-col items-center justify-center gap-8 overflow-y-auto py-12 bg-base-100 text-4xl font-semibold opacity-0 scale-95 pointer-events-none transition-all duration-300 ease-out peer-checked:opacity-100 peer-checked:scale-100 peer-checked:pointer-events-auto lg:static lg:inset-auto lg:z-auto lg:order-2 lg:flex-row lg:gap-1 lg:overflow-visible lg:py-0 lg:bg-transparent lg:text-lg lg:opacity-100 lg:scale-100 lg:pointer-events-auto lg:transition-none"
  >
    <ul
      class="menu px-1 font-semibold flex flex-col items-center gap-2 lg:flex-row lg:menu-horizontal lg:gap-0"
    >
      <li>
        <details>
          <summary
            class={`text-3xl lg:text-2xl ${currentPath.includes('/issues') ? 'text-primary font-black' : ''}`}
            >Retos de Denver</summary
          >
          <ul class="bg-base-100 rounded-t-none p-2 z-10">
            <li>
              <a
                href="/es/issues/affordability"
                class={`${currentPath.includes('/es/issues/affordability') ? 'text-primary font-black' : ''}`}
                ><Coins />Asequibilidad</a
              >
            </li>
            <li>
              <a
                href="/es/issues/housing-crisis"
                class={`${currentPath.includes('/es/issues/housing-crisis') ? 'text-primary font-black' : ''}`}
                ><MapPinHouse />Crisis de Vivienda</a
              >
            </li>
            <li>
              <a
                href="/es/issues/criminal-injustice"
                class={`${currentPath.includes('/es/issues/criminal-injustice') ? 'text-primary font-black' : ''}`}
                ><Siren />Injusticia Penal</a
              >
            </li>
            <li>
              <a
                href="/es/issues/food-security"
                class={`${currentPath.includes('/es/issues/food-security') ? 'text-primary font-black' : ''}`}
                ><Apple />Seguridad Alimentaria</a
              >
            </li>
            <li>
              <a
                href="/es/issues/homelessness"
                class={`${currentPath.includes('/es/issues/homelessness') ? 'text-primary font-black' : ''}`}
                ><HouseHeart />Personas sin Hogar</a
              >
            </li>
            <li>
              <a
                href="/es/issues/big-tech"
                class={`${currentPath.includes('/es/issues/big-tech') ? 'text-primary font-black' : ''}`}
                ><DatabaseZap />Grandes Tecnológicas</a
              >
            </li>
            <li>
              <a href="/es/issues" class="inline-flex items-center"
                >Ver Todos <ArrowRight class="size-4" /></a
              >
            </li>
          </ul>
        </details>
      </li>
      <li>
        <a
          class={`text-3xl lg:text-2xl ${currentPath.includes('/es/why-me') ? 'text-primary font-black' : ''}`}
          href="/es/why-me">¿Por qué yo?</a
        >
      </li>
      <li>
        <details>
          <summary
            class={`text-3xl lg:text-2xl ${currentPath.includes('/es/get-involved') ? 'text-primary font-black' : ''}`}
            >Involúcrate</summary
          >
          <ul class="bg-base-100 rounded-t-none p-2 z-10">
            <li>
              <a
                href="/es/get-involved/events"
                class={`${currentPath.includes('/es/get-involved/events') ? 'text-primary font-black' : ''}`}
                ><CalendarDays />Eventos</a
              >
            </li>
            <li>
              <a
                href="/es/donate"
                class={`${currentPath.includes('/es/donate') ? 'text-primary font-black' : ''}`}
                ><HandCoins />Donar</a
              >
            </li>
            <li>
              <a
                href="/es/get-involved/volunteer"
                class={`${currentPath.includes('/es/get-involved/volunteer') ? 'text-primary font-black' : ''}`}
                ><Users />Voluntario</a
              >
            </li>
            <li>
              <a
                href="/es/get-involved/contact-me"
                class={`${currentPath.includes('/es/get-involved/contact-me') ? 'text-primary font-black' : ''}`}
                ><MessageCircle />Contáctanos</a
              >
            </li>
          </ul>
        </details>
      </li>
      <li class="group relative">
        <a
          class={`text-3xl lg:text-2xl ${currentPath.includes('/posts') ? 'text-primary font-black' : ''}`}
          href="/es/posts">Publicaciones</a
        >
        <ul
          class="hidden lg:group-hover:block absolute top-full right-0 min-w-64 bg-base-100 rounded-box p-2 shadow-xl z-10"
        >
          {
            recentPosts.map((post) => (
              <li>
                <a href={`/es/posts/${post.data.slug}`}>{post.data.title_es}</a>
              </li>
            ))
          }
          <li>
            <a href="/es/posts" class="inline-flex items-center"
              >Ver Todas <ArrowRight class="size-4" /></a
            >
          </li>
        </ul>
      </li>
    </ul>
  </nav>
</div>

<script is:inline>
  document
    .getElementById('lang-switch-en')
    ?.addEventListener('click', function () {
      window.posthog?.capture('language_switched', { to: 'en' })
    })
</script>
