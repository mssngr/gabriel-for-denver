---
import { Image } from 'astro:assets'
import {
  CalendarDays,
  Globe,
  Menu,
  MessageCircle,
  Users,
  X,
} from '@lucide/astro'
import logoDesktop from '../../assets/gfd-logo.svg'
import NavMarker from './nav-marker.astro'

const currentPath = Astro.url.pathname
const isPlatformActive = currentPath.includes('/es/platform')
const isWhyMeActive = currentPath.includes('/es/why-me')
const isGetInvolvedActive = currentPath.includes('/es/get-involved')

// A current nav item is marked with an underline (NavMarker), a separate
// element from the link/summary rather than a border on it — both so it
// isn't clipped by the dropdown's `overflow: hidden` and so it doesn't
// curve with the link's rounded hover background.
const navItemClasses = (active: boolean) =>
  `text-3xl lg:text-2xl ${active ? 'font-black' : ''}`
---

<div
  class="relative z-40 w-full h-40 lg:h-56 p-8 lg:px-16 lg:py-8 grid grid-cols-[auto_1fr_auto] items-center lg:flex lg:justify-between transition-colors duration-300 has-[#mobile-menu-toggle:checked]:bg-secondary lg:bg-transparent"
>
  <input
    type="checkbox"
    id="mobile-menu-toggle"
    class="peer sr-only"
    aria-label="Menú"
  />
  <a class="relative z-50 h-28 lg:h-36 shrink-0 lg:order-1" href="/es"
    ><Image
      class="h-full w-auto"
      src={logoDesktop}
      alt="Logo that reads 'Gabriel for Denver'"
    /></a
  >
  <label
    for="mobile-menu-toggle"
    class="relative z-50 lg:hidden justify-self-end inline-flex items-center cursor-pointer peer-checked:[&>.icon-menu]:hidden peer-checked:[&>.icon-x]:block"
  >
    <Menu class="icon-menu size-7" aria-hidden="true" />
    <X class="icon-x size-7 hidden" aria-hidden="true" />
  </label>
  <nav
    class="fixed inset-x-0 top-0 bottom-0 z-30 flex flex-col items-center justify-center gap-8 overflow-y-auto py-12 bg-secondary text-white text-4xl font-semibold opacity-0 scale-95 pointer-events-none transition-all duration-300 ease-out peer-checked:opacity-100 peer-checked:scale-100 peer-checked:pointer-events-auto lg:static lg:inset-auto lg:z-auto lg:order-2 lg:flex-row lg:gap-1 lg:overflow-visible lg:py-0 lg:bg-transparent lg:text-inherit lg:text-lg lg:opacity-100 lg:scale-100 lg:pointer-events-auto lg:transition-none"
  >
    <ul
      class="menu px-1 font-semibold flex flex-col items-center gap-4 lg:flex-row lg:menu-horizontal"
    >
      <li class="relative">
        <a class={navItemClasses(isPlatformActive)} href="/es/platform"
          >Plataforma</a
        >
        <NavMarker active={isPlatformActive} />
      </li>
      <li class="relative">
        <a class={navItemClasses(isWhyMeActive)} href="/es/why-me"
          >¿Por qué yo?</a
        >
        <NavMarker active={isWhyMeActive} />
      </li>
      <li class="relative">
        <details>
          <summary class={navItemClasses(isGetInvolvedActive)}
            >Involúcrate</summary
          >
          <ul
            class="bg-base-100 text-base-content p-2 z-10 lg:w-max lg:whitespace-nowrap"
          >
            <li>
              <a
                href="/es/get-involved/events"
                class={`${currentPath.includes('/es/get-involved/events') ? 'text-primary font-black' : ''}`}
                ><CalendarDays />Eventos</a
              >
            </li>
            <li>
              <a
                href="/es/get-involved/volunteer"
                class={`${currentPath.includes('/es/get-involved/volunteer') ? 'text-primary font-black' : ''}`}
                ><Users />Voluntario</a
              >
            </li>
            <li>
              <a
                href="/es/get-involved/contact-me"
                class={`${currentPath.includes('/es/get-involved/contact-me') ? 'text-primary font-black' : ''}`}
                ><MessageCircle />Contáctanos</a
              >
            </li>
          </ul>
        </details>
        <NavMarker active={isGetInvolvedActive} />
      </li>
      <li>
        <a class="btn btn-accent" href="/es/donate">Donar</a>
      </li>
      <li>
        <a
          href={currentPath.replace('/es', '') || '/'}
          class="btn btn-outline border-white text-white hover:bg-white hover:text-primary relative z-50 justify-self-center lg:order-3"
          id="lang-switch-en"
          ><Globe class="size-5" aria-hidden="true" /><span>en</span></a
        >
      </li>
    </ul>
  </nav>
</div>

<script is:inline>
  document
    .getElementById('lang-switch-en')
    ?.addEventListener('click', function () {
      window.posthog?.capture('language_switched', { to: 'en' })
    })
</script>
