---
import GuideCard from '../platform/guide-card.astro'
import { planksForGuide } from '../../lib/platform'
import { getPublishedPlatform } from '../../lib/platform-content'

// The same cards as the platform index, rather than a second list of the same
// subjects written a different way: one component, one set of titles, and a
// new guide reaches the home page the moment it's published.
const { guides, planks } = await getPublishedPlatform()
---

<h1 class="text-center mb-16!">What will I tackle?</h1>
<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {
    guides.map((guide) => (
      <GuideCard
        guide={guide}
        planks={planksForGuide(planks, guide.data.slug)}
        lang="en"
      />
    ))
  }
</div>
