---
import GuideCard from '../platform/guide-card.astro'
import { planksForGuide } from '../../lib/platform'
import { getPublishedPlatform } from '../../lib/platform-content'

// See index.astro: the home page shows the platform's own cards rather than a
// second list of the same subjects.
const { guides, planks } = await getPublishedPlatform()
---

<h1 class="text-center mb-16!">¿Qué voy a enfrentar?</h1>
<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {
    guides.map((guide) => (
      <GuideCard
        guide={guide}
        planks={planksForGuide(planks, guide.data.slug)}
        lang="es"
      />
    ))
  }
</div>
