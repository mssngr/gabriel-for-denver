---
import {
  altTextFor,
  displayImageUrl,
  getInstagramPosts,
} from '../lib/instagram'

interface Props {
  labels: {
    emptyState: string
    genericAlt: string
  }
}

const { labels } = Astro.props
const posts = await getInstagramPosts(import.meta.env.FEEDFRAMER_API_KEY)
---

<div class="grid grid-cols-2 sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
  {
    posts.map((post) => (
      <a
        href={post.permalink}
        target="_blank"
        rel="noopener noreferrer"
        class="block aspect-square overflow-hidden rounded-2xl shadow-xl"
      >
        <img
          src={displayImageUrl(post)}
          alt={altTextFor(post, labels.genericAlt)}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </a>
    ))
  }
</div>
<p class="text-center font-light" hidden={posts.length > 0}>
  {labels.emptyState}
</p>
