---
import { Check, Printer, Share2, X } from '@lucide/astro'
import {
  BALLOT_COPY,
  chipText,
  type Lang,
  type SlateGroup,
  sectionLabel,
} from '../../lib/ballot'
import { formatBallotDate } from '../../lib/ballot-calendar'
import type { BallotItemEntry } from '../../lib/ballot-content'

interface Props {
  groups: SlateGroup<BallotItemEntry>[]
  electionDate: Date
  lang: Lang
  pageUrl: string
  shareTitle: string
}

const { groups, electionDate, lang, pageUrl, shareTitle } = Astro.props
const copy = BALLOT_COPY[lang]

const year = electionDate.getUTCFullYear()
const date = formatBallotDate(electionDate, lang)
const subtitle =
  lang === 'es'
    ? `Elección general del ${date} de ${year}`
    : `${date}, ${year} general election`
// The footer is part of the screenshot, so it names the page without its
// scheme or trailing slash: what someone types after reading it off a
// friend's phone.
const displayUrl = pageUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')
---

<section class="slate-wrap" id="slate" aria-labelledby="slate-heading">
  <div class="slate-head">
    <h2 id="slate-heading">{copy.slateHeading}</h2>
    <p>{copy.slateHint}</p>
  </div>
  <div class="slate">
    <div class="slate__top">
      <div class="slate__title">
        {copy.slateTitle}<small>{subtitle}</small>
      </div>
      <div class="slate__key">{copy.slateKey}</div>
    </div>
    <div class="slate__groups">
      {
        groups.map(({ section, items }) => (
          <div>
            <h3>{sectionLabel(section, lang)}</h3>
            <ul class="chips">
              {items.map(({ data }) => (
                <li>
                  <a class={`chip chip--${data.stance}`} href={`#${data.slug}`}>
                    {data.stance === 'yes' && <Check aria-hidden="true" />}
                    {data.stance === 'no' && <X aria-hidden="true" />}
                    {chipText(data, lang)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="slate__foot">
      <span>{copy.slateFoot}</span>
      <b>{displayUrl}</b>
    </div>
  </div>
  <div class="slate-actions">
    <button
      type="button"
      class="slate-btn slate-btn--primary"
      data-ballot-share="guide"
      data-share-url={pageUrl}
      data-share-title={shareTitle}
      ><Share2 aria-hidden="true" />{copy.shareGuide}</button
    >
    <button type="button" class="slate-btn" data-ballot-print
      ><Printer aria-hidden="true" />{copy.print}</button
    >
  </div>
</section>

<style>
  .slate-wrap {
    background: var(--color-neutral);
    padding: 1.5rem 0.75rem;
  }
  @media (min-width: 768px) {
    .slate-wrap {
      padding: 2.25rem 3rem;
    }
  }
  .slate-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 0.25rem 1rem;
    margin: 0 0.375rem 0.875rem;
    color: var(--color-tertiary);
  }
  .slate-head h2 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
  }
  .slate-head p {
    margin: 0;
    font-size: 0.95rem;
    opacity: 0.8;
  }
  .slate {
    display: grid;
    gap: 1rem;
    background: var(--color-tertiary);
    color: #fff;
    border-radius: 1.125rem;
    padding: 1.125rem 1rem 0.875rem;
  }
  @media (min-width: 768px) {
    .slate {
      padding: 1.375rem 1.5rem 1.125rem;
      border-radius: 1.25rem;
    }
  }
  .slate__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.625rem;
  }
  .slate__title {
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1;
  }
  .slate__title small {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-edu-sa-hand);
    color: var(--color-accent);
    font-size: 1rem;
  }
  .slate__key {
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0.8;
    text-align: right;
  }
  .slate__groups {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .slate__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.875rem 1.375rem;
    }
  }
  .slate__groups h3 {
    margin: 0 0 0.375rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .chips li {
    font-size: inherit;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 2px solid transparent;
    border-radius: 0.5rem;
    padding: 0.3rem 0.55rem 0.15rem;
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }
  .chip :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
    margin-top: -0.15rem;
    flex: none;
    stroke-width: 3.5;
  }
  .chip--yes {
    background: var(--color-accent);
    color: var(--color-tertiary);
  }
  .chip--no {
    border-color: rgb(255 255 255 / 0.7);
    color: #fff;
  }
  .chip--pick {
    background: #fff;
    color: var(--color-primary);
  }
  .chip--none {
    border-style: dashed;
    border-color: rgb(255 255 255 / 0.5);
    color: rgb(255 255 255 / 0.85);
    font-weight: 600;
  }
  .chip:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .slate__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.2);
    padding-top: 0.625rem;
    font-size: 0.8rem;
    opacity: 0.85;
  }
  .slate__foot b {
    color: var(--color-accent);
  }
  .slate-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin: 0.875rem 0.375rem 0;
  }
  .slate-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex: 1 1 auto;
    border: 2px solid var(--color-primary);
    border-radius: 0.625rem;
    background: #fff;
    color: var(--color-primary);
    padding: 0.6rem 1rem 0.45rem;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }
  @media (min-width: 768px) {
    .slate-btn {
      flex: none;
    }
  }
  .slate-btn :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: -0.15rem;
  }
  .slate-btn--primary {
    background: var(--color-primary);
    color: #fff;
  }
</style>
