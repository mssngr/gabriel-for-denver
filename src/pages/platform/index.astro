---
import { getEntry } from 'astro:content'
import { marked } from 'marked'
import GuideCard from '../../components/platform/guide-card.astro'
import { planksForGuide, platformSummary } from '../../lib/platform'
import { getPublishedPlatform } from '../../lib/platform-content'
import Layout from '../../layouts/default.astro'

const lang = 'en' as const
const { guides, planks } = await getPublishedPlatform()
const page = await getEntry('pages', 'platform')
const intro = page?.data && marked.parse(page.data.content)
const summary = platformSummary(planks.length, guides.length, lang)
---

<Layout
  title="The platform | Gabriel for Denver"
  description="Every promise Gabriel Konkle is making, across every issue."
  heroGradient
  tightHero
>
  <section slot="hero" class="px-6 pt-6 pb-10 md:px-12 md:pt-10 md:pb-14">
    {
      summary && (
        <p class="text-xs tracking-[0.2em] uppercase font-semibold opacity-75 mb-2">
          {summary}
        </p>
      )
    }
    <h1>{page?.data.heading}</h1>
    {
      /* The width cap goes on each paragraph, not this wrapper: `ch` is
         measured in the element's own font size, and the wrapper's is half
         the intro's. */
    }
    <div
      class="font-light [&_strong]:font-bold [&_p]:max-w-[44ch] [&_p]:text-2xl [&_p]:leading-tight [&_p+p]:mt-4"
      set:html={intro}
    />
  </section>

  <main class="px-6 pt-10 pb-16 md:px-12 md:pt-12 md:pb-20">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        guides.map((guide) => (
          <GuideCard
            guide={guide}
            planks={planksForGuide(planks, guide.data.slug)}
            lang={lang}
          />
        ))
      }
    </div>
  </main>
</Layout>
