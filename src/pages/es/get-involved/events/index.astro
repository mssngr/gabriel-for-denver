---
import { Image } from 'astro:assets'
import { getEntry } from 'astro:content'
import { marked } from 'marked'
import events from '../../../../assets/events.svg'
import UpcomingEvents from '../../../../components/upcoming-events/es'
import Layout from '../../../../layouts/espanol.astro'

const page = await getEntry('pages', 'events')
const content = page?.data && marked.parse(page.data.content_es)
---

<Layout
  title="Eventos | Gabriel por Denver"
  description="Vea dónde estará Gabriel Konkle próximamente — conózcalo en persona, haga preguntas y firme la petición para que aparezca en la boleta de noviembre."
>
  <main class="h-full p-8 md:p-16 pb-0! flex flex-col gap-32">
    <section class="size-full flex flex-wrap justify-center items-center gap-8">
      <div class="w-md [&_a]:link">
        <h1>{page?.data.heading_es}</h1>
        <Fragment set:html={content} />
      </div>
      <Image
        src={events}
        alt={page?.data.photoAltText_es || null}
        class="w-full max-w-md"
      />
    </section>
    <section
      class="w-[calc(100% + 2rem)] bg-secondary px-8 md:px-16 py-32 -mx-8 md:-mx-16 text-white"
    >
      <UpcomingEvents />
    </section>
  </main>
</Layout>
