---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import { marked } from "marked";
import events from "../../../../assets/events.svg";
import Layout from "../../../../layouts/espanol.astro";
import {
  formatEventTime,
  getUpcomingEvents,
  listedUntil,
} from "../../../../lib/events";

const page = await getEntry("pages", "events");
const content = page?.data && marked.parse(page.data.content_es);

const upcomingEvents = await getUpcomingEvents();
---

<Layout>
  <main class="h-full p-8 md:p-16 pb-0! flex flex-col gap-32">
    <section class="size-full flex flex-wrap justify-center items-center gap-8">
      <div class="w-md [&_a]:link">
        <h1>{page?.data.heading_es}</h1>
        <Fragment set:html={content} />
      </div>
      <Image
        src={events}
        alt={page?.data.photoAltText_es || null}
        class="w-full max-w-md"
      />
    </section>
    <section
      class="w-[calc(100% + 2rem)] bg-secondary px-8 md:px-16 py-32 -mx-8 md:-mx-16 text-white"
    >
      <h1 class="text-center mb-16!">Dónde voy a estar</h1>
      <div class="flex flex-col gap-24">
        {
          upcomingEvents.map((event) => (
            <div
              class="flex flex-wrap items-center justify-center gap-16"
              data-event-until={listedUntil(event.data.startTime).toISOString()}
            >
              <Image
                src={event.data.image}
                alt={event.data.imageAlt_es}
                class="flex-1 max-w-48"
              />
              <div class="flex-1 max-w-2xl">
                <h2>{event.data.title_es}</h2>
                <p>{event.data.location}</p>
                <h3>{formatEventTime(event.data.startTime)}</h3>
                <div
                  class="font-light mt-4"
                  set:html={marked.parse(event.data.description_es)}
                />
              </div>
            </div>
          ))
        }
      </div>
      <p
        id="no-upcoming-events"
        class="text-center font-light"
        hidden={upcomingEvents.length > 0}
      >
        No hay eventos próximos en este momento. ¡Vuelve pronto!
      </p>
    </section>
  </main>
</Layout>

<script is:inline>
  // La página es pre-renderizada, así que oculta los eventos que ya pasaron.
  (function () {
    var now = Date.now();
    var remaining = 0;
    document.querySelectorAll("[data-event-until]").forEach(function (event) {
      if (Date.parse(event.dataset.eventUntil) <= now) {
        event.hidden = true;
      } else {
        remaining += 1;
      }
    });
    if (remaining === 0) {
      document.getElementById("no-upcoming-events")?.removeAttribute("hidden");
    }
  })();
</script>
