---
import Band from '../../../components/platform/band.astro'
import GuideCta from '../../../components/platform/guide-cta.astro'
import GuideHero from '../../../components/platform/guide-hero.astro'
import PlankRail from '../../../components/platform/plank-rail.astro'
import SheetBehavior from '../../../components/platform/sheet-behavior.astro'
import {
  currentPageUrl,
  guideMetaDescription,
  localized,
  nextGuide,
  relatedGuides,
  showsPlankRail,
} from '../../../lib/platform'
import { getGuides, getPlanks } from '../../../lib/platform-content'
import Espanol from '../../../layouts/espanol.astro'

export async function getStaticPaths() {
  const guides = await getGuides()
  return guides.map((guide) => ({
    params: { id: guide.data.slug },
    props: { guide },
  }))
}

const { guide } = Astro.props
const lang = 'es' as const

const planks = await getPlanks(guide)
const besideRail = showsPlankRail(planks.length)
const guides = await getGuides()
const published = guides.filter((entry) => entry.data.status === 'published')
// 1-based place among published guides; 0 for a draft, which has no place.
const position =
  published.findIndex((entry) => entry.data.slug === guide.data.slug) + 1

const title = localized(guide.data, 'title', lang) ?? guide.data.title
const pageTitle = `${title} | Gabriel for Denver`
const pageUrl = currentPageUrl(Astro.url.pathname, Astro.site)
---

<Espanol
  title={pageTitle}
  description={guideMetaDescription(guide.data, lang)}
  noindex={guide.data.status === 'draft'}
  heroGradient
  tightHero
>
  <script
    is:inline
    define:vars={{ guideSlug: guide.data.slug, guideTitle: title }}
  >
    window.posthog?.capture('platform_guide_viewed', {
      guide_slug: guideSlug,
      guide_title: guideTitle,
      lang: 'es',
    })
  </script>

  <GuideHero
    slot="hero"
    guide={guide}
    lang={lang}
    position={position}
    publishedCount={published.length}
    plankCount={planks.length}
  />

  <main class="flex flex-col">
    <PlankRail planks={planks} lang={lang}>
      {
        planks.map((plank, index) => (
          <Band
            plank={plank}
            guideTitle={title}
            index={index}
            lang={lang}
            besideRail={besideRail}
          />
        ))
      }
    </PlankRail>

    <GuideCta
      plankCount={planks.length}
      related={relatedGuides(guides, guide.data, lang)}
      next={nextGuide(guides, guide.data)}
      lang={lang}
      shareTitle={pageTitle}
      shareUrl={pageUrl}
    />
  </main>

  <SheetBehavior />
</Espanol>
