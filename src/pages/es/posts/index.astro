---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { stripMarkdown } from '../../../lib/seo'
import Espanol from '../../../layouts/espanol.astro'

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)

const dateFormatter = new Intl.DateTimeFormat('es-ES', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
})
---

<Espanol
  title="Publicaciones | Gabriel por Denver"
  description="Actualizaciones de la campaña de Gabriel Konkle para el Concejo Municipal de Denver."
>
  <main class="h-full p-8 md:p-16 flex flex-col gap-16">
    <h1>Publicaciones</h1>
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <a
            href={`/es/posts/${post.data.slug}`}
            class="flex flex-col gap-3"
          >
            <Image
              src={post.data.photo}
              alt={post.data.photoAlt_es}
              class="w-full aspect-video object-cover rounded-3xl"
            />
            <p class="text-base! text-secondary font-semibold">
              {dateFormatter.format(post.data.date)}
            </p>
            <h2 class="mb-0!">{post.data.title_es}</h2>
            <p class="text-lg!">{stripMarkdown(post.data.intro_es)}</p>
          </a>
        ))
      }
    </div>
  </main>
</Espanol>
