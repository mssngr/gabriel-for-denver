---
import { Image } from 'astro:assets'
import { getEntry } from 'astro:content'
import { marked } from 'marked'
import city from '../../assets/city.svg'
import WhatWillITackle from '../../components/what-will-i-tackle/index.astro'
import Layout from '../../layouts/default.astro'

const page = await getEntry('pages', 'issues')
const content = page?.data && marked.parse(page.data?.content)
---

<Layout
  title="Issues Denver Faces | Gabriel for Denver"
  description="From the housing crisis to police accountability, see the issues facing Denver and Gabriel Konkle's plan to fix them as your next City Councilmember."
  heroGradient
>
  <section
    slot="hero"
    class="size-full flex flex-wrap justify-center items-center gap-8 p-8 md:p-16 pb-0"
  >
    <div class="w-md">
      <h1>{page?.data.heading}</h1>
      <Fragment set:html={content} />
    </div>
    <Image
      src={city}
      alt={page?.data.photoAltText || null}
      class="w-full max-w-md"
    />
  </section>
  <main class="h-full px-8 md:px-16 flex flex-col gap-32">
    <section
      id="what-will-i-tackle"
      class="w-[calc(100% + 2rem)] bg-neutral px-8 md:px-16 py-32 -mx-8 md:-mx-16 text-black"
    >
      <WhatWillITackle />
    </section>
  </main>
</Layout>
