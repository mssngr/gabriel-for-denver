---
import { Image } from 'astro:assets'
import { getEntry, render } from 'astro:content'
import { marked } from 'marked'
import contact from '../../assets/contact.svg'
import ContactForm from '../../components/contact-form/index.astro'
import Layout from '../../layouts/default.astro'

const page = await getEntry('pages', 'contact-me')
const content = page?.data && marked.parse(page.data.content)
---

<Layout
  title="Contact Me | Gabriel for Denver"
  description="Get in touch with Gabriel Konkle's campaign for Denver City Council At Large B — share your ideas, ask a question, or request an event."
  heroGradient
>
  <section
    slot="hero"
    class="size-full flex flex-wrap justify-center items-center gap-8 p-8 md:p-16 pb-0"
  >
    <div class="w-md [&_a]:link">
      <h1>{page?.data.heading}</h1>
      <Fragment set:html={content} />
    </div>
    <Image
      src={contact}
      alt={page?.data.photoAltText || null}
      class="w-full max-w-md"
    />
  </section>
  <main class="h-full px-8 md:px-16 flex flex-col gap-32">
    <section
      class="w-[calc(100% + 2rem)] bg-neutral px-8 md:px-16 py-32 -mx-8 md:-mx-16 text-black"
    >
      <ContactForm />
    </section>
  </main>
</Layout>
