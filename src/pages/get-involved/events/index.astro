---
import { Image } from 'astro:assets'
import { getEntry } from 'astro:content'
import { marked } from 'marked'
import events from '../../../assets/events.svg'
import UpcomingEvents from '../../../components/upcoming-events/index.astro'
import Layout from '../../../layouts/default.astro'

const page = await getEntry('pages', 'events')
const content = page?.data && marked.parse(page.data.content)
---

<Layout
  title="Events | Gabriel for Denver"
  description="See where Gabriel Konkle is showing up next — meet him in person, ask questions, and sign the petition to get him on November's ballot."
  heroGradient
>
  <section
    slot="hero"
    class="size-full flex flex-wrap justify-center items-center gap-8 p-8 md:p-16 pb-0"
  >
    <div class="w-md [&_a]:link">
      <h1>{page?.data.heading}</h1>
      <Fragment set:html={content} />
    </div>
    <Image
      src={events}
      alt={page?.data.photoAltText || null}
      class="w-full max-w-md"
    />
  </section>
  <main class="h-full px-8 md:px-16 flex flex-col gap-32">
    <section
      class="w-[calc(100% + 2rem)] bg-neutral px-8 md:px-16 py-32 -mx-8 md:-mx-16 text-black"
    >
      <UpcomingEvents />
    </section>
  </main>
</Layout>
