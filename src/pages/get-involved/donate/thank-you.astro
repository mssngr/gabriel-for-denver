---
import { Image } from 'astro:assets'
import celebrate from '../../../assets/celebrate.svg'
import Layout from '../../../layouts/default.astro'
---

<Layout>
  <script is:inline>
    window.posthog?.capture('donation_completed')
  </script>
  <main class="h-full p-8 md:p-16 flex flex-col gap-32">
    <section class="size-full flex flex-wrap justify-center items-center gap-8">
      <div class="w-md">
        <h1>Thank you!</h1>
        <p>
          Your contribution is scheduled. Since the campaign doesn't kick into
          full gear until August 6th, you won't be charged until then.
        </p>
        <p class="mt-4">
          Want to do more than donate? Come meet me in person — I'd love to
          see you at an upcoming event.
        </p>
        <a class="btn btn-accent mt-8" href="/get-involved/events"
          >Join me at an event</a
        >
      </div>
      <Image
        src={celebrate}
        alt="Illustration of two people celebrating"
        class="w-full max-w-md"
      />
    </section>
  </main>
</Layout>
