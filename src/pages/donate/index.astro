---
import { getEntry } from 'astro:content'
import { marked } from 'marked'
import DonationForm from '../../components/donation-form/index.astro'
import Layout from '../../layouts/default.astro'

const page = await getEntry('pages', 'donate')
const content = page?.data && marked.parse(page.data.content)
---

<Layout
  title="Donate | Gabriel for Denver"
  description="Donate to Gabriel Konkle's campaign for Denver City Council At Large B. Thanks to Denver's Fair Elections Fund, your first $50 is matched 900% by the city."
>
  <main class="h-full p-8 md:p-16 flex flex-col gap-32">
    <section
      class="size-full flex flex-wrap justify-center items-start gap-x-16 gap-y-12"
    >
      <div class="w-md [&_a]:link">
        <h1>{page?.data.heading}</h1>
        <Fragment set:html={content} />
      </div>
      <DonationForm />
    </section>
  </main>
</Layout>
