---
import { Image } from 'astro:assets'
import meAndMicala from '../assets/me-and-micala.jpg'
import Endorsements from '../components/endorsements/index.astro'
import MyBackground from '../components/my-background/index.astro'
import TopicActions from '../components/platform/topic-actions.astro'
import Layout from '../layouts/default.astro'
---

<Layout
  title="Why Me? | Gabriel for Denver"
  description="Meet Gabriel Konkle — a Denver husband and father running for City Council At Large B with a clear, specific plan for social justice and affordability."
  heroGradient
>
  <section
    slot="hero"
    class="size-full flex flex-wrap justify-center items-center gap-8 p-8 md:p-16 pb-0"
  >
    <div class="w-md">
      <h1>Why me?</h1>
      <p>
        I'll get straight to the point. I'm a husband and father in an
        interracial, blended family. I've lived under the poverty line and also
        in the disappearing "middle class". <strong
          >I am one of those terrible, bleeding-heart liberals with a
          progressive agenda.</strong
        > 😉 And, what sets me apart is, I have clear and specific legislation in
        mind for my term as City Councillor.
      </p>
    </div>
    <Image src={meAndMicala} alt="Photo of Gabriel" class="w-full max-w-md" />
  </section>
  <main class="h-full px-8 md:px-16 flex flex-col pb-0!">
    <section
      class="w-[calc(100% + 2rem)] bg-neutral px-8 md:px-16 py-32 -mx-8 md:-mx-16 text-black"
    >
      <h1 class="text-center mb-16!">My Plan</h1>
      <p class="max-w-md mx-auto mb-16">
        I believe candidates should be defined, first, by who they are and,
        secondly, by what they will do. I have been clear from the beginning: I
        plan to hit the ground running, writing and championing legislation for
        several key issues.
      </p>
      <TopicActions lang="en" />
      <p class="text-center mt-16">
        You can read more about my plans <a href="/platform" class="link"
          >here.</a
        >
      </p>
    </section>
    <section
      class="w-[calc(100% + 2rem)] bg-[linear-gradient(to_bottom_right,var(--color-primary),var(--color-tertiary))] px-8 md:px-16 py-32 -mx-8 md:-mx-16 text-white"
    >
      <h1 class="text-center mb-16!">My Background</h1>
      <MyBackground />
    </section>
    <section
      class="w-[calc(100% + 2rem)] bg-neutral px-8 md:px-16 py-32 -mx-8 md:-mx-16 text-black"
    >
      <Endorsements />
    </section>
  </main>
</Layout>
